+++ b/backend/app/services/qc_ticket_imports.py
@@ -0,0 +1,262 @@
+"""Parsing and validation for the QcTicket bulk-import pipeline.
+
+Reads the actual columns Jira's export produces (verified against a real export sample):
+Clave de incidencia, Tipo de Incidencia, Clave del proyecto, Prioridad, Estado, Creada,
+Resuelta, Resumen, "Campo personalizado (Cluster)". Dates use Jira's default Spanish-locale
+format: DD/MMM/YY HH:MM AM|PM (e.g. "25/ago/26 03:45 PM").
+
+Device/SWF are intentionally NOT derived here: the reference tool computed them via a
+business-maintained Program-to-Device lookup table we don't have visibility into. Only
+"Campo personalizado (Programa Afectado)" (the raw affected-program field) is imported;
+deriving Device/SWF from it is a follow-up once that mapping is provided.
+
+Cluster values are normalized to the same 5-value vocabulary Release.cluster uses. Any raw
+value outside that list is not silently dropped -- it surfaces as a warning if aliased, or a
+warning (imported without cluster) if completely unrecognized.
+"""
+
+import csv
+import io
+import re
+from dataclasses import dataclass
+from datetime import date as date_cls
+
+import openpyxl
+
+from app.models.qc_ticket import QcTicketPriority, QcTicketSource
+from app.schemas.qc_tickets import QcTicketCreate, QcTicketImportRowError
+
+_REQUIRED_HEADERS = ["issue_key", "priority_raw", "status_raw", "created_date"]
+
+_HEADER_ALIASES = {
+    "clave de incidencia": "issue_key",
+    "tipo de incidencia": "issue_type",
+    "clave del proyecto": "project_key",
+    "prioridad": "priority_raw",
+    "estado": "status_raw",
+    "creada": "created_date",
+    "resuelta": "resolved_date",
+    "resumen": "summary",
+    "campo personalizado (cluster)": "cluster_raw",
+    "campo personalizado (programa afectado)": "affected_program",
+}
+
+# Canonical Cluster vocabulary Release.cluster already uses. "Mexico"/"Colombia" are regions
+# reported under the Global cluster per product decision -- not a new cluster value.
+_CLUSTER_ALIASES = {
+    "AUP": "AUP",
+    "ANDINA": "Andina",
+    "CENAM": "CENAM",
+    "DOMINICANA": "Dominicana",
+    "GLOBAL": "Global",
+    "MEXICO": "Global",
+    "MÉXICO": "Global",
+    "COLOMBIA": "Global",
+}
+_REGION_FOLDED_INTO_GLOBAL = {"MEXICO", "MÉXICO", "COLOMBIA"}
+
+# Statuses observed in a real export. Unrecognized statuses default to OPEN (safer for
+# visibility than silently hiding a ticket from the backlog) and are flagged as a warning.
+_CLOSED_STATUSES = {"FINALIZADA", "CERRADA", "DONE", "RESUELTA", "CANCELADA", "CANCELLED"}
+_KNOWN_OPEN_STATUSES = {
+    "TO DEVELOP", "IN PROGRAM REVIEW", "PENDING EXTERNAL DATA", "PENDING BUSINESS OWNER",
+}
+
+_MONTHS_ES = {
+    "ene": 1, "feb": 2, "mar": 3, "abr": 4, "may": 5, "jun": 6,
+    "jul": 7, "ago": 8, "sep": 9, "oct": 10, "nov": 11, "dic": 12,
+}
+_DATE_RE = re.compile(r"(\d{2})/(\w{3})/(\d{2})\s+(\d{1,2}):(\d{2})\s*(AM|PM)", re.IGNORECASE)
+
+
+class QcTicketImportStructureError(Exception):
+    def __init__(self, messages: list[str]) -> None:
+        super().__init__("; ".join(messages))
+        self.messages = messages
+
+
+@dataclass
+class _RawRow:
+    row_number: int
+    values: dict[str, str]
+
+
+def _clean(value: object) -> str:
+    return "" if value is None else str(value).strip()
+
+
+def _normalize_header(raw: str) -> str | None:
+    return _HEADER_ALIASES.get(raw.strip().lower())
+
+
+def _parse_jira_date(raw: str) -> date_cls | None:
+    match = _DATE_RE.match(raw.strip())
+    if not match:
+        return None
+    day, mon_es, yy, _hh, _mm, _ampm = match.groups()
+    month = _MONTHS_ES.get(mon_es.lower())
+    if month is None:
+        return None
+    try:
+        return date_cls(2000 + int(yy), month, int(day))
+    except ValueError:
+        return None
+
+
+def _read_grid(filename: str, content: bytes) -> list[list[object]]:
+    lower = filename.lower()
+    if lower.endswith(".csv"):
+        text = content.decode("utf-8-sig")
+        return list(csv.reader(io.StringIO(text)))
+    if lower.endswith((".xlsx", ".xlsm")):
+        workbook = openpyxl.load_workbook(io.BytesIO(content), data_only=True, read_only=True)
+        sheet = workbook.worksheets[0]
+        return [list(row) for row in sheet.iter_rows(values_only=True)]
+    raise QcTicketImportStructureError(
+        ["Formato de archivo no soportado. Solo se aceptan archivos .csv o .xlsx."]
+    )
+
+
+def parse_file(filename: str, content: bytes) -> list[_RawRow]:
+    grid = _read_grid(filename, content)
+    if not grid:
+        raise QcTicketImportStructureError(["El archivo está vacío."])
+
+    header_row = grid[0]
+    canonical_by_index: dict[int, str] = {}
+    for index, raw_header in enumerate(header_row):
+        if raw_header is None:
+            continue
+        canonical = _normalize_header(str(raw_header))
+        if canonical is not None:
+            canonical_by_index[index] = canonical
+
+    found = set(canonical_by_index.values())
+    missing = [f for f in _REQUIRED_HEADERS if f not in found]
+    if missing:
+        raise QcTicketImportStructureError(
+            [f"Faltan columnas obligatorias en el archivo: {', '.join(missing)}."]
+        )
+
+    rows: list[_RawRow] = []
+    for offset, data_row in enumerate(grid[1:], start=2):
+        if all(cell is None or _clean(cell) == "" for cell in data_row):
+            continue
+        values = {
+            canonical: _clean(data_row[index] if index < len(data_row) else None)
+            for index, canonical in canonical_by_index.items()
+        }
+        rows.append(_RawRow(row_number=offset, values=values))
+
+    if not rows:
+        raise QcTicketImportStructureError(["El archivo no contiene filas de datos."])
+
+    return rows
+
+
+def _resolve_priority(raw: str) -> QcTicketPriority:
+    lowered = raw.lower()
+    if "impedimento" in lowered or "blocker" in lowered:
+        return QcTicketPriority.BLOCKER
+    if "crítica" in lowered or "critica" in lowered or "critical" in lowered:
+        return QcTicketPriority.CRITICAL
+    return QcTicketPriority.OTHER
+
+
+def validate_rows(
+    rows: list[_RawRow], source: QcTicketSource
+) -> tuple[list[QcTicketCreate], list[QcTicketImportRowError], list[QcTicketImportRowError]]:
+    valid: list[QcTicketCreate] = []
+    errors: list[QcTicketImportRowError] = []
+    warnings: list[QcTicketImportRowError] = []
+    seen_keys: dict[str, int] = {}
+
+    for row in rows:
+        issue_key = row.values.get("issue_key", "")
+        if not issue_key:
+            errors.append(
+                QcTicketImportRowError(row_number=row.row_number, message="Falta Clave de incidencia.")
+            )
+            continue
+        if issue_key in seen_keys:
+            errors.append(
+                QcTicketImportRowError(
+                    issue_key=issue_key,
+                    row_number=row.row_number,
+                    message=f"'{issue_key}' está duplicado dentro del archivo (fila {seen_keys[issue_key]}).",
+                )
+            )
+            continue
+        seen_keys[issue_key] = row.row_number
+
+        created_raw = row.values.get("created_date", "")
+        created = _parse_jira_date(created_raw) if created_raw else None
+        if created is None:
+            errors.append(
+                QcTicketImportRowError(
+                    issue_key=issue_key,
+                    row_number=row.row_number,
+                    message=f"'{issue_key}': fecha 'Creada' inválida o vacía ('{created_raw}').",
+                )
+            )
+            continue
+
+        resolved_raw = row.values.get("resolved_date", "")
+        resolved = _parse_jira_date(resolved_raw) if resolved_raw else None
+
+        status_raw = row.values.get("status_raw", "")
+        status_upper = status_raw.strip().upper()
+        is_open = status_upper not in _CLOSED_STATUSES
+        if status_upper not in _CLOSED_STATUSES and status_upper not in _KNOWN_OPEN_STATUSES:
+            warnings.append(
+                QcTicketImportRowError(
+                    issue_key=issue_key,
+                    row_number=row.row_number,
+                    message=(
+                        f"'{issue_key}': estado '{status_raw}' no reconocido, se asumió ABIERTO "
+                        "por seguridad -- revisa si debería contarse como cerrado."
+                    ),
+                )
+            )
+
+        cluster_raw = row.values.get("cluster_raw", "")
+        cluster: str | None = None
+        if cluster_raw:
+            normalized = _CLUSTER_ALIASES.get(cluster_raw.strip().upper())
+            if normalized is None:
+                warnings.append(
+                    QcTicketImportRowError(
+                        issue_key=issue_key,
+                        row_number=row.row_number,
+                        message=f"'{issue_key}': Cluster '{cluster_raw}' no reconocido, se importó sin cluster.",
+                    )
+                )
+            else:
+                cluster = normalized
+                if cluster_raw.strip().upper() in _REGION_FOLDED_INTO_GLOBAL:
+                    warnings.append(
+                        QcTicketImportRowError(
+                            issue_key=issue_key,
+                            row_number=row.row_number,
+                            message=f"'{issue_key}': Cluster '{cluster_raw}' se agrupó bajo Global.",
+                        )
+                    )
+
+        valid.append(
+            QcTicketCreate(
+                issue_key=issue_key,
+                issue_type=row.values.get("issue_type") or None,
+                project_key=row.values.get("project_key") or None,
+                priority_bucket=_resolve_priority(row.values.get("priority_raw", "")),
+                status_raw=status_raw,
+                is_open=is_open,
+                source=source,
+                cluster=cluster,
+                affected_program=row.values.get("affected_program") or None,
+                created_date=created,
+                resolved_date=resolved,
+                summary=row.values.get("summary") or None,
+            )
+        )
+
+    return valid, errors, warnings
diff --git a/backend/app/routers/qc_tickets.py b/backend/app/routers/qc_tickets.py
new file mode 100644
