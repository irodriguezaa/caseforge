# Keep Docker volume names after renaming the project folder (caseforge → qcpulse).
COMPOSE_PROJECT_NAME=caseforge

# PostgreSQL (development-only example values)
POSTGRES_DB=caseforge
POSTGRES_USER=caseforge_user
POSTGRES_PASSWORD=change-me-for-local-development

# Backend database connection
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=caseforge
DATABASE_USER=caseforge_user
DATABASE_PASSWORD=change-me-for-local-development

# Frontend-to-backend connection on the Docker network
BACKEND_URL=http://backend:8000

# Jira sync for the QC Tickets radar (OPTIONAL -- leave unset if not using this feature yet).
# Generate the API token at https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_BASE_URL=https://dlatvarg.atlassian.net
# JIRA_EMAIL=your-email@example.com
# JIRA_API_TOKEN=your-api-token-here

# Optional: LLM for Release Apps candidate generation. Without a key, CaseForge
# proposes one evidence-backed candidate per Funcionalidad ticket in the stored RN PDF.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# RN_STORAGE_DIR=/app/data/release_notes

# QC effort indicator for all Releases (execution capacity × integral Release factor).
# QC_CASES_PER_DAY=46
# QC_RELEASE_EFFORT_FACTOR=3.0
# QC_HOURS_PER_DAY=6

# Calendario QC — archivo .ics exportado (Calendario de Mac o Outlook).
# MS_CALENDAR_ICS_PATH=/app/data/release_notes/outlook.ics
# MS_CALENDAR_ICS_QC_ONLY=false
# MS_GRAPH_TIMEZONE=America/Mexico_City

# Auth QC Pulse (usuarios en .env, no en BDD). Formato: email:rol:password separado por comas.
# Roles: jefe (todo), lider (sin borrar ni .ics), tester (Release, sin Dashboard/KPIs),
# consulta (Dashboard y KPIs en solo lectura; sin .ics ni mutaciones).
QC_USERS=ana@claro.com:jefe:change-me-jefe,juan@claro.com:lider:change-me-lider,pedro@claro.com:tester:change-me-tester,sofia@claro.com:consulta:change-me-consulta
QC_SESSION_SECRET=change-me-to-a-long-random-string
# QC_COOKIE_SECURE=false
