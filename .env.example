# PostgreSQL (development-only example values)
POSTGRES_DB=caseforge
POSTGRES_USER=caseforge_user
POSTGRES_PASSWORD=change-me-for-local-development

# Backend database connection
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=caseforge
DATABASE_USER=caseforge_user
DATABASE_PASSWORD=change-me-for-local-development

# Frontend-to-backend connection on the Docker network
BACKEND_URL=http://backend:8000
